<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <Configurations>Debug;Release</Configurations>
        <Platforms>AnyCPU</Platforms>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\..\Src\Common\NeoKolors.Common.csproj" />
        <ProjectReference Include="..\..\Src\Console\NeoKolors.Console.csproj" />
        <ProjectReference Include="..\..\Src\Tui\NeoKolors.Tui.csproj" />
        <ProjectReference Include="..\..\Src\Tui\Core\NeoKolors.Tui.Core.csproj" />
        <ProjectReference Include="..\..\Src\Tui\Elements\NeoKolors.Tui.Elements.csproj" />
        <ProjectReference Include="..\..\Src\Tui\Lifecycle\Core\NeoKolors.Tui.Lifecycle.Core.csproj" />
        <ProjectReference Include="..\..\Src\Tui\Lifecycle\Apps\NeoKolors.Tui.Lifecycle.Apps.csproj" />
        <ProjectReference Include="..\..\Src\Tui\Widgets\NeoKolors.Tui.Widgets.csproj" />
    </ItemGroup>
    
    <ItemGroup>
      <PackageReference Include="Brigadier.NET" Version="2.0.15-beta" />
      <PackageReference Include="Polyfill" Version="11.4.1">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

</Project>
