<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <TargetFrameworks>net5.0;net8.0;netstandard2.1;net10.0</TargetFrameworks>
        <Platforms>AnyCPU</Platforms>
        <Configurations>Debug;Release</Configurations>
        <!--        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>-->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <Authors>KryKom</Authors>
        <Company>KryKom</Company>
        <Version>2026.2-rc3</Version>
        <PackageProjectUrl>https://github.com/KryKomDev/NeoKolors</PackageProjectUrl>
        <PackageLicense>LICENSE</PackageLicense>
        <RepositoryUrl>https://github.com/KryKomDev/NeoKolors</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>Package-Icon.png</PackageIcon>
        <Description>basic console / logging utilites</Description>

        <!-- define constants -->
        <DefineConstants>$(DefineConstants);NK_ENABLE_NATIVE_IO</DefineConstants>

        <DefineConstants Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">$(DefineConstants);NK_LIBIMPORT</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Common\NeoKolors.Common.csproj"/>
        <ProjectReference Include="..\Extensions\NeoKolors.Extensions.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
        <None Include="../../LICENSE" Pack="true" PackagePath="\"/>
        <None Include="../../Assets/Package-Icon.png" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Google.FlatBuffers" Version="25.2.10"/>
        <PackageReference Include="MessagePack" Version="3.1.8"/>
        <PackageReference Include="HasFlagExtension.Generator" Version="2026.3.2">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4"/>
        <PackageReference Include="Implyzer" Version="2026.5.4" OutputItemType="Analyzer" ReferenceOutputAssembly="false">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
</Project>
