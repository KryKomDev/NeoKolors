{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../Src",
          "files": [
            "Common/bin/Release/net10.0/NeoKolors.Common.dll",
            "Console/bin/Release/net10.0/NeoKolors.Console.dll",
            "Extensions/bin/Release/net10.0/NeoKolors.Extensions.dll",
            "Settings/bin/Release/net10.0/NeoKolors.Settings.dll",
            "Tui/bin/Release/net10.0/NeoKolors.Tui.dll",
            "Tui/Core/bin/Release/net10.0/NeoKolors.Tui.Core.dll",
            "Tui/Elements/bin/Release/net10.0/NeoKolors.Tui.Elements.dll",
            "Tui/Fonts/bin/Release/net10.0/NeoKolors.Tui.Fonts.dll",
            "Tui/Lifecycle/Core/bin/Release/net10.0/NeoKolors.Tui.Lifecycle.Core.dll",
            "Tui/Lifecycle/Apps/bin/Release/net10.0/NeoKolors.Tui.Lifecycle.Apps.dll",
            "Tui/Lifecycle/Game2D/bin/Release/net10.0/NeoKolors.Tui.Lifecycle.Game2D.dll",
            "Tui/Lifecycle/Game3D/bin/Release/net10.0/NeoKolors.Tui.Lifecycle.Game3D.dll"
          ]
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml",
      "memberLayout": "separatePages"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "articles/toc.yml",
          "articles/index.md",
          "articles/Project-Structure.md"
        ],
        "exclude": [
          "_site/**",
          "namespaces.md"
        ]
      },
      {
        "files": [
          "api/**/*.yml",
          "api/toc.yml"
        ]
      },
      {
        "src": "../Src/Common/Docs",
        "files": ["**/*.md"],
        "dest": "articles/common"
      },
      {
        "src": "../Src/Console/Docs",
        "files": ["**/*.md"],
        "dest": "articles/console"
      },
      {
        "src": "../Src/Console/Driver",
        "files": ["**/*.md"],
        "dest": "articles/console/Driver"
      },
      {
        "src": "../Src/Extensions/Docs",
        "files": ["**/*.md"],
        "dest": "articles/extensions"
      },
      {
        "src": "../Src/Settings/Docs",
        "files": ["**/*.md"],
        "dest": "articles/settings"
      },
      {
        "src": "../Src/Tui/Docs",
        "files": ["**/*.md"],
        "dest": "articles/tui"
      },
      {
        "src": "../Src/Tui/Elements",
        "files": ["README.md"],
        "dest": "articles/tui/elements"
      },
      {
        "src": "../Src/Tui/Lifecycle",
        "files": ["**/*.md"],
        "dest": "articles/tui/lifecycle"
      },
      {
        "src": "../Tools/NKFont",
        "files": ["README.md"],
        "dest": "articles/tools"
      }
    ],
    "overwrite": [
      {
        "files": [
          "namespaces.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "assets/**"
        ]
      },
      {
        "files": [
          "Font.xsd",
          "Font.Common.xsd",
          "Font.Config.xsd",
          "Font.Manifest.xsd",
          "Font.Map.xsd"
        ],
        "src": "../Src/Tui/Schemas/Fonts/V3",
        "dest": "Schemas/Fonts/v3/"
      }
    ],
    "sitemap": {
      "baseUrl": "https://krykomdev.github.io/NeoKolors",
      "priority": 0.5,
      "changefreq": "monthly"
    },
    "output": "_site",
    "template": [
      "default",
      "modern",
      "templates/dokfx"
    ],
    "globalMetadata": {
      "_appName": "NeoKolors",
      "_gitRepo": "https://github.com/KryKomDev/NeoKolors",
      "_appTitle": "NeoKolors Documentation",
      "_appLogoPath": "assets/Package-Icon.png",
      "_appFaviconPath": "assets/Package-Icon.png",
      "_enableSearch": true,
      "pdf": false,
      "_reworkedApiLayout": true,
      "_appFooter": "<span>Copyright &copy; 2026 KryKom · Licensed under the MIT License · Source code on <a href='https://github.com/KryKomDev/NeoKolors' target='_blank'>GitHub</a> · Generated by <a href='https://dotnet.github.io/docfx/' target='_blank'>DocFX</a> using the <a href='https://github.com/KryKomDev/Dokfx' target='_blank'>Dokfx template</a></span>",
      "_accentColor": "#5400ff"
    }
  }
}
