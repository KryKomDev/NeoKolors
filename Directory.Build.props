<Project>
    <PropertyGroup>
        <LangVersion>14</LangVersion>
        <DefineConstants>
            $(DefineConstants);
            NK_RENDERING_PROFILING;
            NK_ENABLE_NATIVE_IO
        </DefineConstants>

        <DefineConstants>$(DefineConstants.Replace('%0A', '').Replace('%0D', '').Replace(' ', ''))</DefineConstants>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
        <NoWarn>$(NoWarn);CS1591</NoWarn>

        <!-- MinVer Configuration -->
        <MinVerTagPrefix>v</MinVerTagPrefix>
        <MinVerMinimumMajorMinor>2026.3</MinVerMinimumMajorMinor>
        <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
    </PropertyGroup>

    <!-- Aliases -->
    <ItemGroup Condition="$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)', 2)) &lt; 9.0">
        <Using Include="System.Object" Alias="Lock"/> 
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MinVer" Version="6.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Prevent test and example projects from being packed into NuGet packages -->
    <PropertyGroup Condition="$(MSBuildProjectFullPath.Contains('Tests')) Or $(MSBuildProjectFullPath.Contains('Examples'))">
        <IsPackable>false</IsPackable>
    </PropertyGroup>
</Project>
